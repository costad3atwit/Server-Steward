# Copy to .env and fill in. Keep it private:  chmod 600 .env

# --- Required -------------------------------------------------------------
# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs allowed to give admin commands (yours).
# Developer Mode on -> right-click your name -> Copy User ID
DISCORD_OWNER_IDS=
# Shared secret between steward and the executor. Generate with:  openssl rand -hex 32
EXECUTOR_TOKEN=

# --- Model server -----------------------------------------------------------
# Bundled Ollama: keep the "ollama" profile. Using your own Ollama: delete this line
# and set OLLAMA_URL (for an Ollama on the host: http://host.docker.internal:11434).
COMPOSE_PROFILES=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_KEEP_ALIVE=10m

# --- Optional integrations -------------------------------------------------
# Immich admin API key (only needed if integrations.immich.enabled is true).
# Only the executor container receives it.
IMMICH_API_KEY=
# Jellyfin API key (Dashboard > API Keys), for "who is streaming".
JELLYFIN_API_KEY=
# Audiobookshelf API token of an admin user (Settings > Users > your account), for "who is listening".
AUDIOBOOKSHELF_TOKEN=
# Transmission web UI login, if it has one, for torrent progress.
TRANSMISSION_USER=
TRANSMISSION_PASS=

# --- Paths and misc ----------------------------------------------------------
# Your timezone (used for "resumes at ..." times), e.g. America/New_York
TZ=UTC
STEWARD_CONFIG_DIR=./config
STEWARD_KNOWLEDGE_DIR=./knowledge
STEWARD_DATA_DIR=./data
OLLAMA_DATA_DIR=./data/ollama
HELP_BIND=127.0.0.1:8088
DOCKER_SOCKET=/var/run/docker.sock

# Prebuilt images: run `docker compose pull`. Leave as-is to build locally with `docker compose up -d --build`.
STEWARD_IMAGE_OWNER=costad3atwit
STEWARD_VERSION=latest

# Extra compose files, e.g. compose.yaml:compose.gpu.yaml:compose.local.yaml
# COMPOSE_FILE=compose.yaml
